<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.example.demo.framework.utils.RetryListener"/>
    </listeners>
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.example.demo.tests.LoginTest"/>
            <class name="com.example.demo.tests.LoginDDTTest"/>
        </classes>
    </test>
</suite>